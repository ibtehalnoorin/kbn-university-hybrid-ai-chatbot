FLASK_ENV=development
SECRET_KEY=kbn-secret-key-change-in-production-random-hash
DATABASE_URL=sqlite:///kbn_chatbot.db
# To use PostgreSQL with pgvector, set:
# DATABASE_URL=postgresql+psycopg2://chatbot:chatbot_secret@localhost:5432/chatbot
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
VECTOR_DIMENSION=768
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SIMILARITY_THRESHOLD=0.45
FRONTEND_URL=http://localhost:5173
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=30
CRAWL_DELAY_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=15
